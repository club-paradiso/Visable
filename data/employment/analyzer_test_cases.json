{
  "schema_version": "2026-06-employment-analyzer-test-cases",
  "purpose": "Regression fixtures for scripts/employment_code_analyzer.mjs. Every expected code is resolved from data/jobcode_master.json at test time — fixtures assert behaviour, not hard-coded codes, so they cannot drift into hallucination.",
  "assertion_contract": {
    "noHallucinatedCode": "always: every returned candidate code exists in jobcode_master.json with the matching classification type",
    "sourceMetadataPresent": "always: sourceNotes non-empty",
    "tracksSeparated": "always: occupation candidates are type 'occupation', industry candidates type 'industry'",
    "legalityNeverImplied": "always: base caveat (별도 확인) present in warnings",
    "minOccupation": "minimum occupation candidates",
    "minIndustry": "minimum industry candidates",
    "expectAmbiguity": "ambiguityQuestions non-empty",
    "expectFollowUpChips": "followUpChips non-empty",
    "occupationIncludes": "string appears in some occupation candidate name/path",
    "industryIncludes": "string appears in some industry candidate name/path",
    "expectLegalSensitivity": "extracted.legalSensitivity includes these",
    "expectRoleStatus": "extracted.roleStatus equals",
    "expectMaxConfidence": "no candidate exceeds this confidence (low|medium|high)",
    "expectWarningIncludes": "some warning contains each string",
    "notSingleExactName": "no candidate officialName equals this umbrella term (e.g. 아이돌)"
  },
