  {
   "evidence_id": "EV-DEV-002-A",
   "dev20_items": [
    "ARTEMIS-004-DEV-002"
   ],
   "title": "출입국관리법 제10조의2 및 동법 시행령 제12조 (사증발급인정서)",
   "text": "해외에 체류 중인 외국인을 초청하려는 자는 관할 출입국·외국인관서의 장에게 사증발급인정서를 신청하여 발급받은 후, 피초청인이 대한민국 재외공관에 사증을 신청하여야 합니다. 체류기간 연장은 대한민국에 합법적으로 체류 중인 등록외국인의 절차입니다.",
   "content_sha256": "3fb08a5554cde3c63afd159184881955547971d234b9ec81ca273a3929c6127c",
   "claimed_source": {
    "approval_state": "under_review",
    "approved_sha256": "3fb08a5554cde3c63afd159184881955547971d234b9ec81ca273a3929c6127c",
    "domain": "visa_issuance",
    "provenance": "official_manual",
    "content_sha256": "3fb08a5554cde3c63afd159184881955547971d234b9ec81ca273a3929c6127c",
    "review_status": "unreviewed",
    "reviewed_by": null,
