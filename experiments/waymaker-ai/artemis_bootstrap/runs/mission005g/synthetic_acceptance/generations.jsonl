{"case_id": "A05G-32", "session_id": "colab-t4-28879426", "contract_version": "v4", "model_input_sha256": "a9813dc0efd521e65d16e4d6c34986ada3697cab1bea5b83d8f2dcdb74d3044c", "execution_status": "completed", "raw_output": "{\"status\": \"answered\", \"answer\": \"Theo hướng dẫn vận hành Y-9 giả định, lệ phí giấy phép tái nhập cảnh cho người Y-9-1 đang cư trú trong nước là 30,000 KRW.\", \"citations\": [\"E32-MANUAL-P10A\"]}", "raw_output_sha256": "ff0cbc99f2161a7603f5db1456cffcb448cc8965457396f7c6d07497037f6aa2", "evidence_ids": ["E32-MANUAL-P10A"], "prompt_tokens": 490, "generated_token_count": 68, "finish_reason": "eos", "metrics": {"wall_seconds": 8.352605926000024, "first_token_seconds_including_prefill": 0.3307885530000476, "tokens_per_second_including_prefill": 8.141171821398798, "decode_tokens_per_second": 8.352222057000475, "peak_allocated_bytes": 9453511168, "peak_reserved_bytes": 9527361536}, "failure_category": null, "error": null}
