{"case_id": "A05G-30", "session_id": "colab-t4-28879426", "contract_version": "v4", "model_input_sha256": "5fc2ac948cbdff46f7fad16221195e188b29af1e4b63fbb356c4a620cc8bbb24", "execution_status": "completed", "raw_output": "{\"status\": \"conflict\", \"answer\": \"가상 Y-9-2 재입국허가 신청 서류에 대해 두 가지 상충되는 정보가 있습니다. 가상 Y-9 운영지침 12쪽(E30-MANUAL-P12)에 따르면 가상 서식 YF-51 신청서가 필요하며, 가상 공고 제14호(E30-NOTICE-14)에 따르면 가상 서식 YF-55 신청서가 필요하고 가상 서식 YF-51은 받지 않는다고 명시되어 있습니다.\", \"citations\": [\"E30-MANUAL-P12\", \"E30-NOTICE-14\"]}", "raw_output_sha256": "cfc5ec3275dad7c04e7a53f197e60b9db9735d942dd440c0a77fb7fc0c101264", "evidence_ids": ["E30-MANUAL-P12", "E30-NOTICE-14"], "prompt_tokens": 594, "generated_token_count": 156, "finish_reason": "eos", "metrics": {"wall_seconds": 18.611753249999992, "first_token_seconds_including_prefill": 0.384022128999959, "tokens_per_second_including_prefill": 8.38180035510626, "decode_tokens_per_second": 8.503526795028574, "peak_allocated_bytes": 9470602752, "peak_reserved_bytes": 9527361536}, "failure_category": null, "error": null}
