{"case_id": "A05G-40", "session_id": "colab-t4-28879426", "contract_version": "v4", "model_input_sha256": "672004c2b4065d1d7b51d7628ff5d3a322122d38a60d9b67707cce38cc134bbc", "execution_status": "completed", "raw_output": "{\"status\": \"partial\", \"answer\": \"Y-9-2 체류기간 연장에 필요한 서류는 가상 서식 YF-21 신청서와 가상 서식 YF-23 재학확인서입니다. 수수료에 대해서는 정보가 없습니다.\", \"citations\": [\"E40-MANUAL-P6\"]}", "raw_output_sha256": "1f3c353a4e63c7b95bfeb5c8be7444d22a9aae6efbd3d040b15abc3d47a9a011", "evidence_ids": ["E40-MANUAL-P6"], "prompt_tokens": 485, "generated_token_count": 77, "finish_reason": "eos", "metrics": {"wall_seconds": 9.378756962999887, "first_token_seconds_including_prefill": 0.3378015480000158, "tokens_per_second_including_prefill": 8.21004321828282, "decode_tokens_per_second": 8.406191216683606, "peak_allocated_bytes": 9452077568, "peak_reserved_bytes": 9527361536}, "failure_category": null, "error": null}
{"case_id": "A05G-41", "session_id": "colab-t4-28879426", "contract_version": "v4", "model_input_sha256": "b72ab84a1ad477eeb865b96a8aa739cbbfd45825f63f5122d58c46718045bc9f", "execution_status": "completed", "raw_output": "{\"status\": \"partial\", \"answer\": \"The application for Y-9-1 foreigner registration should be submitted at the Aurora Counter of the Virtual Immigration Administration Office.\", \"citations\": [\"E41-MANUAL-P8\"]}", "raw_output_sha256": "04ad02e6b22e0e987453777a9ecac563c44446c479b1bc5522c293a72b8b6187", "evidence_ids": ["E41-MANUAL-P8"], "prompt_tokens": 472, "generated_token_count": 49, "finish_reason": "eos", "metrics": {"wall_seconds": 6.1460289770000145, "first_token_seconds_including_prefill": 0.3349928479999562, "tokens_per_second_including_prefill": 7.972627558927939, "decode_tokens_per_second": 8.260144823477404, "peak_allocated_bytes": 9450613248, "peak_reserved_bytes": 9527361536}, "failure_category": null, "error": null}
{"case_id": "A05G-42", "session_id": "colab-t4-28879426", "contract_version": "v4", "model_input_sha256": "364633e604fd37d85014433e2eeb5702f1542f00032554332597326f8f12138d", "execution_status": "completed", "raw_output": "{\"status\": \"partial\", \"answer\": \"가상 Y-9-3 체류자의 근무처 추가 신고는 체류자 본인이 해야 합니다. 신고 서류는 가상 서식 YF-71 신고서이며, 신고 기한은 추가한 날부터 10일입니다. 수수료에 대한 정보는 제공된 자료에 없습니다.\", \"citations\": [\"E42-MANUAL-P17\"]}", "raw_output_sha256": "a386e4f54fb9d8519539d519bfbd6ee2d1ba0fcaaa4102733cc0a859db3469ce", "evidence_ids": ["E42-MANUAL-P17"], "prompt_tokens": 506, "generated_token_count": 93, "finish_reason": "eos", "metrics": {"wall_seconds": 11.284641329999886, "first_token_seconds_including_prefill": 0.3462666499999614, "tokens_per_second_including_prefill": 8.241289845230813, "decode_tokens_per_second": 8.410755957026756, "peak_allocated_bytes": 9455006208, "peak_reserved_bytes": 9527361536}, "failure_category": null, "error": null}
