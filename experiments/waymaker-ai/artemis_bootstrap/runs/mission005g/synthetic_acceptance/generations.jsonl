{"case_id": "A05G-37", "session_id": "colab-t4-28879426", "contract_version": "v4", "model_input_sha256": "8989f35e9ddf2cdc31663ed808842545b557eb86c210775d11f913978a3a2141", "execution_status": "completed", "raw_output": "{\"status\": \"answered\", \"answer\": \"국내에 체류 중인 가상 Y-9-1 체류자의 재입국허가 신청 장소는 가상 이주행정청 오로라 창구이며, 신청 방법은 방문 접수입니다.\", \"citations\": [\"E37-MANUAL-P10A\"]}", "raw_output_sha256": "61dc335aa0bae286200e483d4b3ea3eb187d5e234559f1725e4e1313b265b707", "evidence_ids": ["E37-MANUAL-P10A", "E37-MANUAL-P10B"], "prompt_tokens": 639, "generated_token_count": 75, "finish_reason": "eos", "metrics": {"wall_seconds": 8.97480605099986, "first_token_seconds_including_prefill": 0.40804934599987064, "tokens_per_second_including_prefill": 8.35672654916531, "decode_tokens_per_second": 8.63804150721473, "peak_allocated_bytes": 9479394816, "peak_reserved_bytes": 9527361536}, "failure_category": null, "error": null}
{"case_id": "A05G-38", "session_id": "colab-t4-28879426", "contract_version": "v4", "model_input_sha256": "49d8afcd302746b5892560828936bdc3920211011ddfe5489a6097cdbdffc299", "execution_status": "completed", "raw_output": "{\"status\": \"answered\", \"answer\": \"Theo hướng dẫn vận hành Y-9 giả định, nếu người cư trú Y-9-1 muốn thêm nơi làm việc, họ phải tự báo cáo. Phương thức báo cáo là bằng văn bản và thời hạn báo cáo là trong vòng 15 ngày kể từ ngày thêm. Nếu là người cư trú Y-9-2, họ phải nộp đơn xin phép trước cho cơ quan có thẩm quyền, không phải cho người sử dụng lao động mới. Phương thức nộp đơn là trực tiếp.\", \"citations\": [\"E38-MANUAL-P15\", \"E38-MANUAL-P16\"]}", "raw_output_sha256": "127e4924e5633e237ea0b355e82d1c31aa5a75a5b5487a1cad695779b14e5b6e", "evidence_ids": ["E38-MANUAL-P15", "E38-MANUAL-P16"], "prompt_tokens": 623, "generated_token_count": 140, "finish_reason": "eos", "metrics": {"wall_seconds": 16.65568288700001, "first_token_seconds_including_prefill": 0.40494082800000797, "tokens_per_second_including_prefill": 8.405539475614772, "decode_tokens_per_second": 8.55345555885055, "peak_allocated_bytes": 9476447232, "peak_reserved_bytes": 9527361536}, "failure_category": null, "error": null}
