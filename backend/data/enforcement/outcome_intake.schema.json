{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visable.local/schemas/enforcement-outcome-intake-v1.json",
  "title": "Enforcement Intelligence v3 de-identified outcome intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetVersion", "jurisdiction", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "datasetVersion": {"type": "string", "minLength": 1, "maxLength": 120},
    "jurisdiction": {"const": "KR"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "caseFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statusOfStay": {"type": ["string", "null"], "maxLength": 40},
        "violationCode": {"type": ["string", "null"], "maxLength": 100},
        "durationDays": {"type": ["integer", "null"], "minimum": 0},
        "priorViolations": {"type": ["integer", "null"], "minimum": 0},
        "voluntaryDisclosure": {"type": ["boolean", "null"]},
        "authorizationObtained": {"type": ["boolean", "null"]},
        "assessmentDate": {"type": "string", "format": "date"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "authority", "recordId", "publicUrl"],
      "properties": {
        "sourceType": {
          "enum": [
            "OFFICIAL_ADMINISTRATIVE_DECISION",
            "COURT_DECISION",
            "VERIFIED_ADMINISTRATIVE_RECORD"
          ]
        },
        "authority": {"type": "string", "minLength": 1, "maxLength": 240},
        "recordId": {"type": "string", "pattern": "^src_[0-9a-f]{24}$"},
        "publicUrl": {
          "type": ["string", "null"],
          "pattern": "^https://"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionDate", "monetaryOutcomeKrw", "dispositionTypes", "primaryDispositionType"],
      "properties": {
        "decisionDate": {"type": "string", "format": "date"},
        "monetaryOutcomeKrw": {"type": ["integer", "null"], "minimum": 0},
        "dispositionTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "primaryDispositionType": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "historyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "at", "actorToken"],
      "properties": {
        "stage": {
          "enum": ["STAGED", "SOURCE_VERIFIED", "INDEPENDENTLY_REVIEWED", "REJECTED"]
        },
        "at": {"type": "string", "format": "date-time"},
        "actorToken": {"type": "string", "pattern": "^reviewer_[0-9a-f]{24}$"},
        "reasonCode": {
          "enum": [
            "SOURCE_INELIGIBLE",
            "PII_PRESENT",
            "DUPLICATE",
            "INSUFFICIENT_EVIDENCE",
            "PREDICTION_DERIVED",
            "REVIEW_CONFLICT"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "reviewStage",
        "caseFacts",
        "provenance",
        "outcome",
        "independentFromPrediction",
        "reviewerRole",
        "reviewHistory"
      ],
      "properties": {
        "caseId": {"type": "string", "pattern": "^case_[0-9a-f]{24}$"},
        "reviewStage": {
          "enum": ["STAGED", "SOURCE_VERIFIED", "INDEPENDENTLY_REVIEWED", "REJECTED"]
        },
        "caseFacts": {"$ref": "#/$defs/caseFacts"},
        "provenance": {
          "anyOf": [
            {"$ref": "#/$defs/provenance"},
            {"type": "null"}
          ]
        },
        "outcome": {
          "anyOf": [
            {"$ref": "#/$defs/outcome"},
            {"type": "null"}
          ]
        },
        "independentFromPrediction": {"type": ["boolean", "null"]},
        "reviewerRole": {"type": ["string", "null"], "maxLength": 120},
        "reviewHistory": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/historyEvent"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"reviewStage": {"enum": ["SOURCE_VERIFIED", "INDEPENDENTLY_REVIEWED"]}},
            "required": ["reviewStage"]
          },
          "then": {"properties": {"provenance": {"$ref": "#/$defs/provenance"}}}
        },
        {
          "if": {
            "properties": {"reviewStage": {"const": "INDEPENDENTLY_REVIEWED"}},
            "required": ["reviewStage"]
          },
          "then": {
            "properties": {
              "outcome": {"$ref": "#/$defs/outcome"},
              "independentFromPrediction": {"const": true},
              "reviewerRole": {"type": "string", "minLength": 1, "maxLength": 120}
            }
          }
        }
      ]
    }
  }
}
