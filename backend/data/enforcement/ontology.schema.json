{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visable.app/schemas/enforcement-ontology-v1.json",
  "title": "Visable Enforcement Ontology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ontologyVersion", "jurisdiction", "purpose", "factDimensions", "violations"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "ontologyVersion": {"type": "string", "minLength": 1},
    "jurisdiction": {"const": "KR"},
    "purpose": {"type": "string", "minLength": 1},
    "factDimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "violations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "labelKo", "category", "legalBasis", "materialFactDimensions", "lifecycle", "supportedByDeterministicRules"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "labelKo": {"type": "string", "minLength": 1},
          "category": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "legalBasis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lawName", "article"],
            "properties": {
              "lawName": {"type": "string", "minLength": 1},
              "article": {"type": "string", "minLength": 1}
            }
          },
          "materialFactDimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "lifecycle": {"enum": ["ACTIVE", "DEPRECATED", "PLANNED"]},
          "supportedByDeterministicRules": {"type": "boolean"}
        }
      }
    }
  }
}
