{"$id":"visable/legal-corpus/articles.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"articles":{"items":{"additionalProperties":false,"properties":{"articleId":{"description":"조 번호 식별자. 가지조문은 '26-2' 형태.","pattern":"^[0-9]+(-[0-9]+)?$","type":"string"},"articleNumber":{"type":"string"},"branchNumber":{"minimum":0,"type":"integer"},"deleted":{"description":"삭제된 조문이면 true. 본문은 비어 있고 '삭제'로 표시된다.","type":"boolean"},"paragraphs":{"items":{"type":"string"},"type":"array"},"text":{"description":"항 단락을 줄바꿈으로 이은 조문 전문 (삭제 조문은 빈 문자열)","type":"string"},"textSha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"titleKo":{"type":["string","null"]}},"required":["articleId","articleNumber","branchNumber","titleKo","deleted","paragraphs","text","textSha256"],"type":"object"},"type":"array"},"effectiveFrom":{"format":"date","type":"string"},"lawId":{"pattern":"^[0-9]{6}$","type":"string"},"lawSlug":{"type":"string"}},"required":["lawId","lawSlug","effectiveFrom","articles"],"title":"Structured articles of one law version","type":"object"}