# Paradiso backend environment variables.
#
# Copy this file to backend/.env for local development:
#   cp backend/.env.example backend/.env
#
# Do NOT commit backend/.env. The repository .gitignore already excludes it.
# In Railway, configure these as Project Variables (do not check them into git).

# --- LLM providers (at least one is required for /api/ask) ---
OPENROUTER_API_KEY=
# Pin Paradiso AI to a deterministic OpenRouter model instead of openrouter/auto.
# This value is ALSO the backend code default (see _DEFAULT_OPENROUTER_MODEL in
# paradiso_backend.py), so Hermes 3 (Llama 3.1 405B) is used for the Basic answer
# tier even if this var is left unset.
# Verify the model remains available in the OpenRouter model catalog before deploy.
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# Explicit, predictable OpenRouter fallback candidates (comma-separated, ordered).
# This is the Basic answer tier: Hermes 3 405B primary, Gemma 4 fallback.
# When the primary model is rate-limited (429) or its upstream is unavailable
# (503 / "no healthy upstream"), Paradiso retries the NEXT candidate instead of
# switching providers or showing raw provider JSON. Random routing
# (openrouter/auto) is intentionally NOT used. If unset, the backend uses the
# built-in policy list below (OPENROUTER_MODEL is always tried first).
OPENROUTER_MODEL_CANDIDATES=nousresearch/hermes-3-llama-3.1-405b:free,google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,meta-llama/llama-4-scout:free

# Fast answer tier (the UI "⚡ Fast" mode): a light, low-latency primary plus a
# 3-deep fallback chain. Unset -> built-in default (4-candidate chain in model_policy.py).
OPENROUTER_FAST_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FAST_MODEL_CANDIDATES=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,meta-llama/llama-3.3-70b-instruct:free

# --- Model role policy ---
# Gemma stays useful, but not as the final legal/status-answer owner.
AI_ROUTER_MODEL=google/gemma-4-31b-it:free
AI_TRANSLATION_MODEL=google/gemma-4-31b-it:free
AI_VERIFIER_MODEL=openai/gpt-oss-120b:free

# China-origin model families are reserved for Chinese-language routes only.
AI_CHINESE_MODEL=deepseek/deepseek-r1-0528:free
AI_CHINESE_FALLBACK_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,moonshotai/kimi-k2.6:free

# Short in-memory cooldown for retryable per-model failures (429/503/timeout).
# During cooldown, later requests skip that model. If all candidates are cooling
# down, Paradiso uses deterministic fallback guidance instead of hammering them.
OPENROUTER_MODEL_COOLDOWN_SECONDS=300

# Hard per-request timeout (seconds) for a single OpenRouter/Groq call. A hung or
# slow provider is converted into a *retryable* upstream timeout so the candidate
# fallback chain + cooldown + deterministic source-grounded note still engage
# (never an uncaught 500 that strands the frontend). Default 60 preserves prior
# behaviour; lower (e.g. 40) for snappier failure under load.
OPENROUTER_TIMEOUT_SECONDS=60

# Groq is intentionally left unconfigured by default so Paradiso does not
# silently answer with a different provider/model when OpenRouter is expected.
#
# NOTE: /api/nationality-coach (국적민원·귀화면접 준비 hub) now runs through the
# SHARED AI runtime under the NATIONALITY_COACH task role: the governed
# candidate chain, the process-wide model cooldown, and the shared provider
# error taxonomy. It used to carry its own Groq-first routing with a single
# model per provider and no chain, so a deployment that had deliberately
# switched to strict OpenRouter-first still answered nationality questions from
# an ungoverned model.
#
# Ordering is now OpenRouter-first (matching every other feature). Groq remains
# a working provider-family fallback — used when OPENROUTER_API_KEY is unset or
# its whole chain failed — so a Groq-only deployment keeps working. That
# fallback is deliberately NOT gated on ALLOW_GROQ_FALLBACK: the coach produces
# practice feedback, not source-grounded legal answers. The provider and model
# that actually answered are reported back in the response.
#
# When neither key is set the endpoint returns 503 and the hub falls back to
# local heuristic feedback (never hangs).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Whether Groq may answer when OpenRouter is NOT configured.
# The code default is now FALSE (strict OpenRouter-first): if OpenRouter is
# unset, /api/ask returns a safe 503 instead of silently answering via a
# different provider/model. /health then reports groq_fallback_allowed:false
# and (when enabled) llm.warnings:["GROQ_FALLBACK_ENABLED"].
#
# Recommended Railway value: false (or simply leave it unset to inherit the
# strict default). Set to true ONLY if you intentionally want a Groq-only
# deployment to answer when OpenRouter is not configured.
ALLOW_GROQ_FALLBACK=false

# NVIDIA hosted API trial scaffold. A key alone never enables traffic; this is
# not wired to /api/ask and must remain non-production/non-personal.
ENABLE_NVIDIA_NIM_EXPERIMENTAL=false
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_TIMEOUT_SECONDS=45
NVIDIA_NIM_MAX_TOKENS=1200
NVIDIA_NIM_REASONING_ENABLED=false
NVIDIA_NIM_ALLOWED_MODES=research,internal_qa
NVIDIA_NIM_ALLOW_PERSONAL_DATA=false

# Optional future private fallback scaffold. Disabled by default and not required
# in CI or production. Do not expose a public Ollama endpoint.
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=20

# --- Korean Open Law API (National Law Information Open API / open.law.go.kr) ---
# LAW_API_OC is the PREFERRED, explicit Open Law API authentication identifier
# (the "OC" query parameter). Register at https://open.law.go.kr/LSO/main.do and
# put your OC value here. It is backend-only and is NEVER exposed to the
# frontend, /health, debug responses, logs, or sanitized source URLs.
LAW_API_OC=
# LAW_API_KEY is kept ONLY as a backward-compatibility fallback. If LAW_API_OC is
# set it takes precedence; if only LAW_API_KEY is set, it is used and a non-secret
# LAW_API_OC_RECOMMENDED warning is surfaced. Do NOT overwrite an existing
# Railway LAW_API_KEY — add LAW_API_OC alongside it.
LAW_API_KEY=
PUBLIC_DATA_API_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Law grounding mode: disabled | audit | enabled.
#   disabled — no external calls; answers are never real-time-law-grounded.
#   audit    — diagnostics / citation-verifier posture. The lookup runs (with a
#              credential) but the answer's user-visible status is
#              `law_grounding_audit_only`: it is NEVER reported as verified
#              real-time law, so specific 조문 numbers are not trusted.
#   enabled  — full grounding. With a credential, usable results yield
#              `law_grounding_verified` and specific citations may be trusted.
# IMPORTANT — credential vs mode (these are two different reasons for "not verified"):
#   * Local/CI default: LAW_API_OC is UNSET, so `enabled` falls back to the
#     effective-disabled rule -> status `law_grounding_disabled`. This is the
#     local/CI diagnosis, NOT production.
#   * Railway PRODUCTION: LAW_API_OC is ALREADY SET. With the current
#     `LAW_GROUNDING_MODE=audit`, the status is `law_grounding_audit_only`
#     (diagnostics posture; live citations are never marked verified) — this is
#     why production answers show "law not verified" even though the OC exists.
# To make real-time citations trustworthy in PRODUCTION, switch to
# `LAW_GROUNDING_MODE=enabled` (the OC is already present) -> usable results then
# yield `law_grounding_verified`. The unverified-citation guardrail protects every
# non-verified state (disabled/audit_only/no_results/failed) in the meantime.
# Railway current posture: LAW_GROUNDING_MODE=audit (OC set). Target: enabled.
LAW_GROUNDING_MODE=audit
LAW_GROUNDING_TIMEOUT_SECONDS=8
LAW_GROUNDING_CACHE_TTL_SECONDS=86400

# Optional audit-mode endpoint configuration for Phase 2 clients.
# Keep blank by default. External calls remain disabled unless
# LAW_GROUNDING_MODE is set to audit/enabled and API keys are present.
LAW_API_BASE_URL=
LAW_API_SEARCH_PATH=
LAW_API_ARTICLE_PATH=

# --- Legal evidence service (판례 / 재결례, supplementary case law) ---
# Authenticated with the SAME LAW_API_OC above (no separate variable). Court
# precedent uses the confirmed DRF target `prec`. The administrative-appeal
# targets are NOT publicly confirmed, so they are best-effort + operator-
# overridable here and degrade gracefully (unknown/blank target -> "unavailable",
# never invented). Leave blank to keep those source types off until verified.
LAW_API_ADMIN_APPEAL_TARGET=decc
LAW_API_SPECIAL_ADMIN_APPEAL_TARGET=

PUBLIC_DATA_BASE_URL=
PUBLIC_DATA_VISA_PATH=
PUBLIC_DATA_JOB_PATH=

# --- Service config ---
# Comma-separated list of allowed origins. Use "*" for development only.
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO

# Public-facing site URL (used as HTTP-Referer for OpenRouter calls and
# in disclaimers). Set to your deployed Paradiso frontend origin.
SITE_URL=

# Surfaced by GET / so a user who opens the bare backend URL on a
# phone sees where the real app lives. Optional. Example:
#   FRONTEND_URL=https://lucanomics.github.io/Paradiso/
FRONTEND_URL=

# Absolute path to visa_data.json. Useful when deploying with
# Root Directory = backend (the repo-root visa_data.json is then not
# part of the build context). Leave unset for local dev.
VISA_DATA_PATH=
