node_modules
# Lockfile is intentionally not tracked: no-build static site; deps are test-only tooling.
package-lock.json

# Temporary audit/extraction scratch files
tmp/

# Environment files - never commit secrets
.env
.env.*
!.env.example

# Python virtualenv and bytecode
.venv/
.venv-check/
__pycache__/
*.pyc
build/

# Trust & Safety event logs (server-controlled, never committed)
backend/var/
test-results/
playwright-report/

# Local/CI QA output (mobile render/WebKit QA, post-search screenshots); uploaded as workflow artifacts, never committed
artifacts/

# Vite build output (Phase 2); Vercel builds it, never committed
dist/

# Local visual baselines (tests/golden): per-machine Chromium renders; only the CI set is committed
tests/golden/__screenshots__/local/
